# Public production URL, without a trailing slash
PUBLIC_SITE_URL=https://YOUR_DOMAIN_TO_CONFIRM

# International format is recommended, for example +385...
PHONE_NUMBER=PHONE_NUMBER_TO_CONFIRM
EMAIL_ADDRESS=EMAIL_TO_CONFIRM
WHATSAPP_NUMBER=WHATSAPP_TO_CONFIRM

# Optional HTTPS endpoint that receives each validated inquiry as JSON.
CONTACT_WEBHOOK_URL=
